{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/archlab-sciencetokyo/SimRV/release/schemas/release-manifest.schema.json",
  "title": "SimRV release manifest",
  "type": "object",
  "required": ["schema_version", "version", "release_tag", "host_support", "guest_profiles", "dependencies", "required_suites", "performance", "artifacts"],
  "properties": {
    "schema_version": {"const": 2},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "release_tag": {"type": "string", "pattern": "^v"},
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "revision", "license", "redistribute"],
        "properties": {
          "url": {"type": "string"}, "revision": {"type": "string", "minLength": 1},
          "license": {"type": "string"}, "redistribute": {"type": "boolean"}
        }
      }
    },
    "required_suites": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "ctest_label", "arches", "compilers", "allow_skip"],
        "properties": {
          "id": {"type": "string"}, "ctest_label": {"type": "string"},
          "arches": {"type": "array", "items": {"enum": [32, 64]}},
          "compilers": {"type": "array", "items": {"enum": ["gcc", "clang"]}},
          "allow_skip": {"type": "boolean"}
        }
      }
    },
    "performance": {
      "type": "object", "required": ["policy", "blocking", "minimum_samples", "statistic"],
      "properties": {"policy": {"const": "evidence-only"}, "blocking": {"const": false}}
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
