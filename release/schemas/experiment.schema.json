{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/archlab-sciencetokyo/SimRV/release/schemas/experiment.schema.json",
  "title": "SimRV experiment manifest",
  "type": "object",
  "required": ["schema_version", "name", "repetitions", "warmups", "timeout_seconds", "configurations", "correctness_suites", "performance", "outputs"],
  "properties": {
    "schema_version": {"const": 1}, "name": {"type": "string"},
    "repetitions": {"type": "integer", "minimum": 1}, "warmups": {"type": "integer", "minimum": 0},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "configurations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "xlen", "isa", "vlen", "preset", "execution_mode"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "xlen": {"enum": [32, 64]},
          "isa": {"type": "string", "pattern": "^rv(32|64)[a-z]+$"},
          "vlen": {"type": "integer", "minimum": 32, "maximum": 1024},
          "preset": {"type": "string", "minLength": 1},
          "execution_mode": {"enum": ["high-performance", "cycle-accurate"]},
          "simrv_args": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "correctness_suites": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "performance": {"type": "object", "required": ["policy", "workloads", "reference"]},
    "outputs": {"type": "object", "required": ["raw", "aggregate", "table", "plot"]}
  }
}
