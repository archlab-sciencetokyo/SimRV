{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/archlab-sciencetokyo/SimRV/release/schemas/experiment.schema.json",
  "title": "SimRV experiment manifest",
  "type": "object",
  "required": ["schema_version", "name", "repetitions", "warmups", "timeout_seconds", "configurations", "performance", "outputs"],
  "properties": {
    "schema_version": {"const": 1}, "name": {"type": "string"},
    "repetitions": {"type": "integer", "minimum": 1}, "warmups": {"type": "integer", "minimum": 0},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "configurations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "xlen", "isa", "vlen", "preset", "execution_mode"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "xlen": {"enum": [32, 64]},
          "isa": {"type": "string", "pattern": "^rv(32|64)[a-z]+$"},
          "vlen": {"type": "integer", "minimum": 32, "maximum": 1024},
          "preset": {"type": "string", "minLength": 1},
          "execution_mode": {"enum": ["high-performance", "cycle-accurate"]},
          "simrv_args": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "performance": {
      "type": "object",
      "required": ["policy", "configurations", "bootstrap_resamples", "confidence", "maximum_cv_percent", "maximum_regression_percent", "minimum_geomean_percent", "workloads", "reference"],
      "properties": {
        "policy": {"enum": ["evidence-only", "enforced"]},
        "configurations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "bootstrap_resamples": {"type": "integer", "minimum": 1},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "maximum_cv_percent": {"type": "number", "minimum": 0},
        "maximum_regression_percent": {"type": "number", "minimum": 0},
        "minimum_geomean_percent": {"type": "number"},
        "workloads": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "target", "instruction_limit"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "target": {"type": "string", "minLength": 1},
              "instruction_limit": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "reference": {"const": "spike"}
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["raw", "aggregate", "table", "plot", "comparison", "evidence", "index"],
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
