#!/usr/bin/env bash
set -euo pipefail

init_module_cmd() {
    if command -v module >/dev/null 2>&1; then
        return 0
    fi
    if [[ -f /etc/profile.d/modules.sh ]]; then
        # shellcheck disable=SC1091
        source /etc/profile.d/modules.sh
    elif [[ -f /usr/share/Modules/init/bash ]]; then
        # shellcheck disable=SC1091
        source /usr/share/Modules/init/bash
    fi
    command -v module >/dev/null 2>&1
}

ensure_clangxx() {
    if command -v clang++ >/dev/null 2>&1; then
        return 0
    fi

    if init_module_cmd; then
        module load archlab/stack >/dev/null 2>&1 || module load archlab/llvm >/dev/null 2>&1 || true
    fi

    command -v clang++ >/dev/null 2>&1
}

if ! ensure_clangxx; then
    cat >&2 <<'EOF'
error: clang++ was not found in PATH.
Tried loading modules: archlab/stack, archlab/llvm
Please run one of the following and retry:
  module load archlab/stack
  module load archlab/llvm
EOF
    exit 1
fi

exec clang++ "$@"
