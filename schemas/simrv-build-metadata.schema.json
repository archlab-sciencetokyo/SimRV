{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simrv.dev/schemas/v3/build-metadata.schema.json",
  "title": "SimRV Build Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "version", "git_sha", "target_xlen", "compiler"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "git_branch": { "type": "string" },
    "git_sha": { "type": "string", "minLength": 1 },
    "target_xlen": { "enum": [32, 64] },
    "build_type": { "type": "string" },
    "generator": { "type": "string" },
    "system": { "type": "string" },
    "processor": { "type": "string" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "source_date_epoch": { "type": ["integer", "null"], "minimum": 0 }
  }
}
