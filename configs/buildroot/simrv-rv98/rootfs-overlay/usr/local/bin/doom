#!/bin/sh
set -eu

shareware_wad=/usr/share/games/doom/doom1.wad
has_iwad=0
for arg in "$@"; do
    case "$arg" in
        -iwad|-iwad=*) has_iwad=1 ;;
    esac
done

if [ "$has_iwad" -eq 0 ] && [ -r "$shareware_wad" ]; then
    set -- -iwad "$shareware_wad" "$@"
fi

export SDL_VIDEODRIVER=fbcon
export SDL_FBDEV=/dev/fb0
export SDL_NOMOUSE=1
export SDL_AUDIODRIVER=dummy
exec /usr/games/prboom "$@"
