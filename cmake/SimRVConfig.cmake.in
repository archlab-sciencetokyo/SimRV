@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(PkgConfig REQUIRED)
pkg_check_modules(LIBSLIRP REQUIRED IMPORTED_TARGET slirp)

include("${CMAKE_CURRENT_LIST_DIR}/SimRVTargets.cmake")

if(TARGET SimRV::simrv-devel AND NOT TARGET SimRV::devel)
  add_library(SimRV::devel ALIAS SimRV::simrv-devel)
endif()

set(SimRV_Runtime_FOUND 1)
set(SimRV_Development_FOUND 1)

check_required_components(SimRV)
