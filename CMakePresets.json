{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "ninja-clang-release",
            "displayName": "Ninja + clang (Release)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-clang-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "${sourceDir}/scripts/archlab-clang",
                "CMAKE_CXX_COMPILER": "${sourceDir}/scripts/archlab-clangxx",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-gcc-o3-lto",
            "displayName": "Ninja + gcc (Release, O3 + LTO)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-gcc-o3-lto",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -flto",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-flto",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ninja-clang-release",
            "configurePreset": "ninja-clang-release"
        },
        {
            "name": "ninja-gcc-o3-lto",
            "configurePreset": "ninja-gcc-o3-lto"
        }
    ]
}