{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "simrv-base",
            "hidden": true,
            "generator": "Ninja",
            "environment": {
                "CCACHE_DIR": "${sourceDir}/build/.ccache",
                "CCACHE_TEMPDIR": "${sourceDir}/build/.ccache-tmp"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "simrv-release",
            "hidden": true,
            "inherits": "simrv-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "simrv-rv32",
            "hidden": true,
            "cacheVariables": {
                "SIMRV_XLEN": "32"
            }
        },
        {
            "name": "simrv-rv64",
            "hidden": true,
            "cacheVariables": {
                "SIMRV_XLEN": "64"
            }
        },
        {
            "name": "rv32-release",
            "displayName": "RV32 Release (Ninja)",
            "inherits": [
                "simrv-release",
                "simrv-rv32"
            ],
            "binaryDir": "${sourceDir}/build/rv32-release",
            "cacheVariables": {}
        },
        {
            "name": "rv64-release",
            "displayName": "RV64 Release (Ninja)",
            "inherits": [
                "simrv-release",
                "simrv-rv64"
            ],
            "binaryDir": "${sourceDir}/build/rv64-release",
            "cacheVariables": {}
        },
        {
            "name": "rv64-native-release",
            "displayName": "RV64 Native-Host Release (Ninja)",
            "generator": "Ninja",
            "environment": {
                "CCACHE_DIR": "${sourceDir}/build/.ccache",
                "CCACHE_TEMPDIR": "${sourceDir}/build/.ccache-tmp"
            },
            "binaryDir": "${sourceDir}/build/rv64-native-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "SIMRV_XLEN": "64",
                "SIMRV_NATIVE_HOST_OPTIMIZATIONS": "ON"
            }
        },
        {
            "name": "rv64-asan",
            "displayName": "RV64 ASAN (Ninja)",
            "inherits": [
                "simrv-release",
                "simrv-rv64"
            ],
            "binaryDir": "/tmp/simrv-build/rv64-asan",
            "cacheVariables": {
                "SIMRV_ENABLE_ASAN": "ON"
            },
            "environment": {
                "CCACHE_DIR": "/tmp/simrv-build/.ccache",
                "CCACHE_TEMPDIR": "/tmp/simrv-build/.ccache-tmp"
            }
        },
        {
            "name": "rv64-ubsan",
            "displayName": "RV64 UBSAN (Ninja)",
            "inherits": [
                "simrv-release",
                "simrv-rv64"
            ],
            "binaryDir": "/tmp/simrv-build/rv64-ubsan",
            "cacheVariables": {
                "SIMRV_ENABLE_UBSAN": "ON"
            },
            "environment": {
                "CCACHE_DIR": "/tmp/simrv-build/.ccache",
                "CCACHE_TEMPDIR": "/tmp/simrv-build/.ccache-tmp"
            }
        },
        {
            "name": "rv64-tsan",
            "displayName": "RV64 TSAN (Ninja)",
            "inherits": [
                "simrv-release",
                "simrv-rv64"
            ],
            "binaryDir": "/tmp/simrv-build/rv64-tsan",
            "cacheVariables": {
                "SIMRV_ENABLE_TSAN": "ON"
            },
            "environment": {
                "CCACHE_DIR": "/tmp/simrv-build/.ccache",
                "CCACHE_TEMPDIR": "/tmp/simrv-build/.ccache-tmp"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "simrv-build-base",
            "hidden": true,
            "environment": {
                "CCACHE_DIR": "${sourceDir}/build/.ccache",
                "CCACHE_TEMPDIR": "${sourceDir}/build/.ccache-tmp"
            }
        },
        {
            "name": "rv32-release",
            "configurePreset": "rv32-release",
            "inherits": "simrv-build-base"
        },
        {
            "name": "rv64-release",
            "configurePreset": "rv64-release",
            "inherits": "simrv-build-base"
        },
        {
            "name": "rv64-native-release",
            "configurePreset": "rv64-native-release",
            "inherits": "simrv-build-base"
        },
        {
            "name": "rv64-asan",
            "configurePreset": "rv64-asan",
            "inherits": "simrv-build-base",
            "environment": {
                "CCACHE_DIR": "/tmp/simrv-build/.ccache",
                "CCACHE_TEMPDIR": "/tmp/simrv-build/.ccache-tmp"
            }
        },
        {
            "name": "rv64-ubsan",
            "configurePreset": "rv64-ubsan",
            "inherits": "simrv-build-base",
            "environment": {
                "CCACHE_DIR": "/tmp/simrv-build/.ccache",
                "CCACHE_TEMPDIR": "/tmp/simrv-build/.ccache-tmp"
            }
        },
        {
            "name": "rv64-tsan",
            "configurePreset": "rv64-tsan",
            "inherits": "simrv-build-base",
            "environment": {
                "CCACHE_DIR": "/tmp/simrv-build/.ccache",
                "CCACHE_TEMPDIR": "/tmp/simrv-build/.ccache-tmp"
            }
        }
    ],
    "testPresets": [
        {
            "name": "rv64-gate",
            "configurePreset": "rv64-release",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "label": "gate"
                }
            }
        },
        {
            "name": "rv32-gate",
            "configurePreset": "rv32-release",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "label": "gate"
                }
            }
        },
        {
            "name": "rv64-asan-gate",
            "configurePreset": "rv64-asan",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "label": "gate"
                }
            }
        },
        {
            "name": "rv64-ubsan-gate",
            "configurePreset": "rv64-ubsan",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "label": "gate"
                }
            }
        },
        {
            "name": "rv64-tsan-gate",
            "configurePreset": "rv64-tsan",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "label": "gate"
                }
            }
        }
    ],
    "packagePresets": [
        {
            "name": "rv64-release-package",
            "configurePreset": "rv64-release",
            "generators": [
                "TGZ"
            ]
        }
    ],
    "workflowPresets": [
        {
            "name": "rv32-gate",
            "displayName": "RV32 release gate",
            "steps": [
                {
                    "type": "configure",
                    "name": "rv32-release"
                },
                {
                    "type": "build",
                    "name": "rv32-release"
                },
                {
                    "type": "test",
                    "name": "rv32-gate"
                }
            ]
        },
        {
            "name": "rv64-gate",
            "displayName": "RV64 release gate",
            "steps": [
                {
                    "type": "configure",
                    "name": "rv64-release"
                },
                {
                    "type": "build",
                    "name": "rv64-release"
                },
                {
                    "type": "test",
                    "name": "rv64-gate"
                }
            ]
        },
        {
            "name": "release-package",
            "displayName": "RV64 release package workflow",
            "steps": [
                {
                    "type": "configure",
                    "name": "rv64-release"
                },
                {
                    "type": "build",
                    "name": "rv64-release"
                },
                {
                    "type": "test",
                    "name": "rv64-gate"
                },
                {
                    "type": "package",
                    "name": "rv64-release-package"
                }
            ]
        }
    ]
}
