{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SimRV Debug (Linux)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/rv64-debug/SimRV",
            "args": [
                "--os",
                "-m",
                "${workspaceFolder}/linux-images/vmlinux",
                "-D",
                "${workspaceFolder}/linux-images/root.bin",
                "-f",
                "${workspaceFolder}/linux-images/devicetree.dtb",
                "-e",
                "200000000"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "sourceLanguages": [
                "cpp"
            ],
            "preLaunchTask": "build-debug"
        },
        {
            "name": "SimRV Debug (Simple)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/rv64-debug/SimRV",
            "args": [
                "--help"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "SimRV Guest (IA)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/ren/workspace/lab/simulators/SimRV/examples/hello/build-rv64/hello.elf",
            "cwd": "/home/ren/workspace/lab/simulators/SimRV",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "miDebuggerServerAddress": "${command:simrv.gdbServerAddressIA}",
            "stopAtEntry": true,
            "externalConsole": false,
            "customLaunchSetupCommands": [],
            "launchCompleteCommand": "None",
            "setupCommands": [
                {
                    "description": "Select the RISC-V RV64 target architecture",
                    "text": "set architecture riscv:rv64",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "build-guest-hello"
        },
        {
            "name": "SimRV Guest (CA)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/ren/workspace/lab/simulators/SimRV/examples/hello/build-rv64/hello.elf",
            "cwd": "/home/ren/workspace/lab/simulators/SimRV",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "miDebuggerServerAddress": "${command:simrv.gdbServerAddressCA}",
            "stopAtEntry": true,
            "externalConsole": false,
            "customLaunchSetupCommands": [],
            "launchCompleteCommand": "None",
            "setupCommands": [
                {
                    "description": "Select the RISC-V RV64 target architecture",
                    "text": "set architecture riscv:rv64",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "build-guest-hello"
        }
    ]
}
