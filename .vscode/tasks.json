{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-guest-hello",
            "type": "shell",
            "command": "make",
            "args": [
                "-C",
                "${workspaceFolder}/examples/hello",
                "-B",
                "all",
                "XLEN=64",
                "DEBUG=1"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "configure-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "rv64-debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "build-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "rv64-debug"
            ],
            "dependsOn": "configure-debug",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true
            },
            "isBackground": false
        },
        {
            "label": "configure-release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "rv64-release"
            ],
            "problemMatcher": []
        },
        {
            "label": "build-release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "rv64-release"
            ],
            "dependsOn": "configure-release",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true
            },
            "isBackground": false
        },
        {
            "label": "phase1-gate",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "rv64-release",
                "--target",
                "phase1-gate"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false
            },
            "isBackground": false
        }
    ]
}
